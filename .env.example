# Copy this file to .env and fill in real values. .env is gitignored.

# From resend.com dashboard -> API Keys. Without it, orders are still saved
# (see Admin -> Orders) but no email is sent.
RESEND_API_KEY=re_your_api_key_here

# Sender address. Until a custom domain is verified on Resend, this must
# stay onboarding@resend.dev (Resend's shared sandbox sender) — and the
# sandbox sender can only deliver to the email that owns the Resend account,
# so create the Resend account with teffehawear@gmail.com.
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# Where new-order emails are sent.
ORDER_NOTIFICATION_EMAIL=teffehawear@gmail.com

# --- Production only (leave unset for local development) ---

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Set to False in production.
DEBUG=False

# Comma-separated list of domains this site is served from, e.g.
#   teffaha.pythonanywhere.com
ALLOWED_HOSTS=

# Comma-separated, must include the scheme, e.g.
#   https://teffaha.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=
